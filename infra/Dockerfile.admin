# Admin (Next.js standalone). Build context: repo root (pnpm workspace).
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY admin/package.json admin/
COPY widget/package.json widget/
RUN pnpm install --frozen-lockfile --filter admin...
COPY admin admin
RUN pnpm -C admin build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /repo/admin/.next/standalone ./
COPY --from=build /repo/admin/.next/static ./admin/.next/static
COPY --from=build /repo/admin/public ./admin/public
USER node
EXPOSE 3000
CMD ["node", "admin/server.js"]
