# Copy to .env (git-ignored — never commit .env). Leave values empty here.
ENV=dev
TZ_DEFAULT=Asia/Karachi

# Database (docker compose: Postgres on host port 55432, Redis on 56379).
# Runtime uses the non-owner role (RLS applies); migrations use the owner role.
DATABASE_URL=postgresql+asyncpg://raabta_app:raabta_app@localhost:55432/raabta
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://raabta:raabta@localhost:55432/raabta
REDIS_URL=redis://localhost:56379/0

# Auth — use a long random string outside dev (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-change-me

# AI providers
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Speech-to-text for WhatsApp voice notes (step 6.4)
STT_PROVIDER=openai
STT_API_KEY=

# Meta WhatsApp Cloud API (step 6.1)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
