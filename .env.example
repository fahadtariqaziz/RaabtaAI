# Copy to .env (never commit .env). Values are placeholders.
ENV=dev
TZ_DEFAULT=Asia/Karachi
# Runtime uses the non-owner role (RLS applies); migrations use MIGRATIONS_DATABASE_URL (owner).
DATABASE_URL=postgresql+asyncpg://raabta_app:raabta_app@localhost:55432/raabta
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://raabta:raabta@localhost:55432/raabta
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=change-me
ANTHROPIC_API_KEY=
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
STT_PROVIDER=openai
STT_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
